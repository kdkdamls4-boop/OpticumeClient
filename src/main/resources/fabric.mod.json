{
  "schemaVersion": 1,
  "id": "opticumeclient",
  "version": "${version}",
  "name": "OpticumeClient",
  "description": "High-performance Minecraft Fabric PvP, visuals and utility client with Dark Neon Glassmorphism UI.",
  "authors": [
    "OpticumeClient Team"
  ],
  "contact": {
    "homepage": "https://github.com/kdkdamls4-boop/OpticumeClient"
  },
  "license": "MIT",
  "icon": "assets/opticumeclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.opticumeclient.OpticumeClient"
    ]
  },
  "mixins": [
    "opticumeclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*"
  }
}
