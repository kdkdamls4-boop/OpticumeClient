{
  "schemaVersion": 1,
  "id": "optimusprime",
  "version": "${version}",
  "name": "OpticumeClient",
  "description": "High-performance Minecraft Fabric PvP, visuals and utility client with Dark Neon Glassmorphism UI.",
  "authors": [
    "Optimus Team"
  ],
  "contact": {
    "homepage": "https://github.com/optimusprime"
  },
  "license": "MIT",
